# Bugzilla MCP Server - Local Configuration
# Copy this file to .env and replace the values with your actual Bugzilla credentials.

# The base URL of your Bugzilla instance (required for local stdio server)
BUGZILLA_URL=https://bugzilla.example.com

# Your Bugzilla API key (required for local stdio server)
# Get your API key from: https://your-bugzilla-instance.com/userprefs.cgi?tab=apikey
BUGZILLA_API_KEY=your-api-key-here
